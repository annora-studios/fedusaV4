<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#031B45" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="24dp" android:background="#041A41" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/title" android:text="FEDUSA" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="CONGRESS 2026" android:textColor="#22D368" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:id="@+id/status" android:text="Staff sign in" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/username" android:hint="Username" android:textColor="#071A3A" android:backgroundTint="#FFFFFF" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/password" android:hint="Password" android:inputType="textPassword" android:textColor="#071A3A" android:backgroundTint="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/login" android:text="SIGN IN" android:textStyle="bold" android:backgroundTint="#0EA34A" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<RadioGroup android:id="@+id/mode" android:visibility="gone" android:orientation="vertical" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<RadioButton android:id="@+id/congressMode" android:checked="true" android:text="CONGRESS CHECK-IN" android:textColor="#FFFFFF" android:textStyle="bold" android:buttonTint="#0EA34A" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<RadioButton android:id="@+id/votingMode" android:text="VOTING SESSION CHECK-IN" android:textColor="#FFFFFF" android:textStyle="bold" android:buttonTint="#8650CE" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</RadioGroup>
<androidx.camera.view.PreviewView android:id="@+id/camera" android:visibility="gone" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<EditText android:id="@+id/manualCode" android:visibility="gone" android:hint="Scan QR or enter badge ID" android:textColor="#071A3A" android:backgroundTint="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/manual" android:visibility="gone" android:text="SCAN / MANUAL CHECK-IN" android:textStyle="bold" android:backgroundTint="#0EA34A" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:id="@+id/result" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:padding="16dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></LinearLayout>
